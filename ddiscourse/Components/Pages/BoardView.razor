@page "/boards/{Id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using ddiscourse.Data

@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<PageTitle>@(board is null ? "Board not found" : $"Discourse on {board.Name}")</PageTitle>

@if (loading)
{
    <p class="muted">Loading…</p>
}
else if (board is null)
{
    <div class="card empty">
        <h3>Board not found</h3>
        <p>It may have been removed, or the link is wrong.</p>
        <a class="btn" href="boards">Back to Boards</a>
    </div>
}
else
{
    <div class="crumbs row">
        <a href="boards">← Back to Boards</a>
        @if (isAdmin)
        {
            <span class="spacer">
                <a class="btn btn-outline btn-sm spacer" href="boards/@board.Id/edit">Edit</a>
                <button type="button" class="btn btn-outline btn-sm spacer"
                        @onclick="() => confirmingDelete = true">Delete</button>
            </span>
        }
    </div>

    <div class="card board-head c@(Id % 6)">
        <div class="band"></div>
        <div class="body">
            <h1>@board.Name</h1>
            <p class="muted">@CountText</p>
        </div>
        
        @if (confirmingDelete)
        {
            <div class="confirm">
                <b>Delete this board, all its articles, and all their comments?</b>
                <div class="row wrap">
                    <button type="button" class="btn btn-danger btn-sm" disabled="@busy" @onclick="DeleteBoardAsync">Yes, delete
                        it</button>
                        <button type="button" class="link-btn" @onclick="() => confirmingDelete = false">Cancel</button>
                    </div>
                </div>
            }
        </div>

        @if (allArticles.Count == 0)
        {
            @* The board itself is empty *@
            <div class="card empty">
                <h3>Empty board</h3>
                @if (userId is not null)
                {
                    <p>Be the first to publish an article on @board.Name.</p>
                    <a class="btn" href="articles/new?boardid=@board.Id">Write article</a>
                }
                else
                {
                    <p>There are no articles on @board.Name yet.</p>
                    <a class="btn" href="Account/Login?ReturnUrl=%2Farticles%2Fnew?boardid=@board.Id">Sign in to write an article</a>
                }
            </div>
        }
        else
        {
            <div class="filters filters-2">
                <ArticleSearch @bind-Value="searchText" @bind-Value:after="ApplyFilter" Placeholder="@($"Search {board.Name}")" />

                <select class="input" aria-label="Sort articles" @bind="sort" @bind:after="ApplyFilter">
                    <option value="@SortArticle.Newest">Newest</option>
                    <option value="@SortArticle.Top">Top rated</option>
                    <option value="@SortArticle.MostDiscussed">Most discussed</option>
                </select>
            </div>

            @if (visible.Count == 0)
            {
                @* Articles exist, but none match the search. The search box stays on screen. *@
                <div class="card empty">
                    <h3>No matches</h3>
                    <p>Nothing on @board.Name matches “@searchText.Trim()”.</p>
                    <button type="button" class="btn btn-outline" @onclick="ClearSearch">Clear search</button>
                </div>
            }
            else
            {
                @foreach (var article in visible)
                {
                    <ArticleCard article="article" />
                }
            }
        }
    }

@code {
    [Parameter] public int Id { get; set; }

    private Board? board;
    private List<Article> allArticles = new(); // everything on this board, loaded once. Never edited by the search.
    private List<Article> visible = new(); // what is shown after search + sort
    private string searchText = "";
    private SortArticle sort = SortArticle.Newest;
    private string? userId;
    private bool isAdmin;
    private bool loading = true;
    private bool busy;
    private bool confirmingDelete;

    private string CountText
    {
        get
        {
            var total = allArticles.Count;
            if (total == 0) return "No articles";
            if (!string.IsNullOrWhiteSpace(searchText)) return $"{visible.Count} of {total} articles";
            return total == 1 ? "1 article" : $"{total} articles";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        searchText = "";
        sort = SortArticle.Newest;

        var auth = await AuthProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        isAdmin = auth.User.IsInRole("Admin");

        Board boardModel = new();
        board = await boardModel.GetBoard(Db, Id);

        if (board is null)
        {
            allArticles = new();
        }
        else
        {
            // Load once. Include whatever ArticleCard shows (author, comment count, rating).
            Article articleModel = new();
            allArticles = await articleModel.GetAllArticles(Db, Id);
        }

        ApplyFilter();
        loading = false;
    }

    private async Task DeleteBoardAsync()
    {
        busy = true;
        try
        {
            // Only an Admin can delete boards. Doing so deletes their articles, and deletes those articles' comments.
            Db.Boards.Remove(board!);
            await Db.SaveChangesAsync();
            Nav.NavigateTo("boards");
        }
        finally
        {
            busy = false;
        }

        return;
    }

    // Builds `visible` from `allArticles`. allArticles itself is never changed, so clearing the search brings everything.
    private void ApplyFilter()
    {
        visible = ArticleHelper.ApplyArticleFilter(allArticles, searchText, sort);
    }

    private void ClearSearch()
    {
        searchText = "";
        ApplyFilter();
    }
}
