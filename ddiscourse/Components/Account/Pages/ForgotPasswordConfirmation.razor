@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot password confirmation</PageTitle>

<div class="card empty auth-card">
    <h3>Check your email</h3>
    <p role="alert">If an account exists for that email, we have sent a link to reset your password.</p>
    <a class="btn" href="Account/Login">Back to sign in</a>
</div>
