@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using ddiscourse.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetAuthenticator> Logger

<PageTitle>Reset authenticator key</PageTitle>

<StatusMessage />

<div class="card card-pad stack">
    <h2 class="card-title">Reset authenticator key</h2>
    <div class="alert alert-warning alert-block" role="alert">
        <strong>If you reset your authenticator key, your authenticator app will not work until you set it up again.</strong>
        <p>This process disables 2FA until you verify your authenticator app. If you do not finish setting it up, you may lose access to your account.</p>
    </div>
    <form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <div class="row wrap">
            <button class="btn btn-danger" type="submit">Reset authenticator key</button>
            <a class="btn btn-outline" href="Account/Manage/TwoFactorAuthentication">Cancel</a>
        </div>
    </form>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task OnSubmitAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(user, false);
        await UserManager.ResetAuthenticatorKeyAsync(user);
        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has reset their authentication app key.", userId);

        await SignInManager.RefreshSignInAsync(user);

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/EnableAuthenticator",
            "Your authenticator app key has been reset, you will need to configure your authenticator app using the new key.",
            HttpContext);
    }
}
