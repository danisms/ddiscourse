@* Desktop sidebar content. No wrapper element on purpose: these items become direct
   children of <aside class="sidebar">, which app.css expects (e.g. ".sidebar > .btn").
   NavLink adds the "active" class to the <a> itself, which .nav-item.active styles. *@

<a class="brand" href=""><img src="logo.png" alt="" />Discourse</a>

<NavLink class="nav-item" href="" Match="NavLinkMatch.All"><Icon Name="home" />Home</NavLink>
<NavLink class="nav-item" href="boards"><Icon Name="boards" />Boards</NavLink>

<AuthorizeView>
    <Authorized>
        <NavLink class="nav-item" href="Account/Manage"><Icon Name="user" />Account</NavLink>
        <NavLink class="btn" href="articles/new">Write article</NavLink>

        <div class="sidebar-user">
            <div class="user-chip">
                <span class="avatar avatar-lg c0" aria-hidden="true">@UserDisplay.Initials(context.User)</span>
                <span>@UserDisplay.Name(context.User)<small>@UserDisplay.Role(context.User)</small></span>
            </div>
            <SignOutButton />
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="sidebar-user">
            <a class="btn btn-block" href="Account/Login">Sign in</a>
            <a class="btn btn-outline btn-block" href="Account/Register">Create account</a>
        </div>
    </NotAuthorized>
</AuthorizeView>
