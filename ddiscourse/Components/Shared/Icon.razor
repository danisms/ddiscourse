@* Inline SVG icons that inherit the text colour (stroke="currentColor"), so they turn blue
   automatically when a nav item is .active. Usage: <Icon Name="home" /> *@
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@((MarkupString)Path)</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    private static readonly Dictionary<string, string> Paths = new()
    {
        ["home"] = "<path d=\"M3 11l9-8 9 8v10H3z\"/>",
        ["boards"] = "<rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/>",
        ["write"] = "<path d=\"M12 5v14M5 12h14\"/>",
        ["user"] = "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4 4-6 8-6s8 2 8 6\"/>",
        ["search"] = "<circle cx=\"11\" cy=\"11\" r=\"7\"></circle><path d=\"M21 21l-4-4\"></path>"
    };

    private string Path => Paths.GetValueOrDefault(Name, "");
}
