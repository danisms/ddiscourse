@* Posts to the Identity logout endpoint (same pattern as the template). Returns to Home.
   Reuse on the Account page for mobile: <SignOutButton Class="btn btn-outline" /> *@
<form action="Account/Logout" method="post">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="" />
    <button type="submit" class="@Class">Sign out</button>
</form>

@code {
    [Parameter] public string Class { get; set; } = "btn-outline btn btn-block";
}
